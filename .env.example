# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Anthropic (Claude) — required for syllabus parsing
ANTHROPIC_API_KEY=sk-ant-...

# Twilio Verify — optional SMS phone verification (Profile → Text reminders)
# Auth via API Key + Secret (not Auth Token):
#   twilio(TWILIO_API_KEY, TWILIO_CLIENT_SECRET, { accountSid: TWILIO_ACCOUNT_SID })
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxx
TWILIO_CLIENT_SECRET=your_api_key_secret
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx
# Optional — not used by Verify send/check:
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Google Calendar sync (testing mode) — OAuth push-only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.coremaxsystems.com/api/auth/google/callback
# Required: 64-char hex (32 bytes). Connect refuses to store tokens without it.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Stripe Checkout (use TEST mode keys locally: sk_test_… / pk_test_…)
STRIPE_SECRET_KEY=sk_test_…
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_…
# From: stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_…
# Recurring Price IDs from Stripe Dashboard (test mode). Lookup keys: coursework_pro_monthly, coursework_pro_6month, coursework_pro_annual
STRIPE_PRICE_MONTHLY=price_…
STRIPE_PRICE_6MONTH=price_…
STRIPE_PRICE_ANNUAL=price_…
# Optional override for Checkout success/cancel URLs (defaults to http://localhost:3000)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — transactional email (src/lib/email.ts)
RESEND_API_KEY=re_…



